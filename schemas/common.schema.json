{
  "$defs": {
    "analyzer": {
      "additionalProperties": false,
      "description": "One analyzer's lifetime counters, from the store's `counter` table - the rows `fathom index --stats` prints (ADR-004 \u00a74.8).",
      "properties": {
        "bumped": {
          "type": "integer"
        },
        "bytes": {
          "type": "integer"
        },
        "cold": {
          "type": "integer"
        },
        "computes": {
          "description": "Misses: lookups minus hits. `puts` counts writes; this counts work.",
          "type": "integer"
        },
        "cost_ms": {
          "type": "integer"
        },
        "epoch_stale": {
          "type": "integer"
        },
        "hit_rate": {
          "description": "`null` when nothing was asked: 'there was nothing to ask' is not 0%.",
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "hits": {
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "lookups": {
          "type": "integer"
        },
        "negative_hits": {
          "type": "integer"
        },
        "puts": {
          "description": "Rows written, including a recompute after a hit.",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "lookups",
        "hits",
        "negative_hits",
        "cold",
        "bumped",
        "epoch_stale",
        "puts",
        "computes",
        "bytes",
        "cost_ms",
        "hit_rate"
      ],
      "type": "object"
    },
    "cache": {
      "additionalProperties": true,
      "description": "Cache state and the hit rate, over the store's whole life rather than one run.",
      "properties": {
        "analyzers": {
          "items": {
            "$ref": "#/$defs/analyzer"
          },
          "type": "array"
        },
        "blob_bytes": {
          "type": "integer"
        },
        "blobs": {
          "type": "integer"
        },
        "blobs_inline": {
          "type": "integer"
        },
        "blobs_on_disk": {
          "type": "integer"
        },
        "computed": {
          "type": "integer"
        },
        "hit_rate": {
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "hits": {
          "type": "integer"
        },
        "lookups": {
          "type": "integer"
        },
        "registered_analyzers": {
          "type": "integer"
        },
        "rows": {
          "type": "integer"
        },
        "served_bytes": {
          "type": "integer"
        },
        "stale_rows": {
          "type": "integer"
        },
        "stored_failures": {
          "type": "integer"
        },
        "unknown_analyzer_rows": {
          "type": "integer"
        }
      },
      "required": [
        "hit_rate",
        "lookups",
        "hits",
        "computed",
        "analyzers"
      ],
      "type": "object"
    },
    "finding": {
      "additionalProperties": false,
      "description": "One diagnostic, always with its remedy: ADR-006 \u00a710.3's 'a shrug is not a remedy'.",
      "properties": {
        "code": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "exit_name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "remedy": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "severity": {
          "description": "What the finding costs the verb that printed it: `degraded` is a missing or wrong answer and moves the exit code of every verb that reports the index; `untidy` is housekeeping \u2014 reported with its remedy everywhere, and it moves an exit code only under `fathom doctor --strict`.",
          "enum": [
            "degraded",
            "untidy"
          ],
          "type": "string"
        }
      },
      "required": [
        "code",
        "exit_code",
        "exit_name",
        "message",
        "remedy",
        "section",
        "severity"
      ],
      "type": "object"
    },
    "index": {
      "additionalProperties": true,
      "description": "Index state: where the store is, what it holds, whether it can be trusted, what it still owes.",
      "properties": {
        "commits": {
          "type": "integer"
        },
        "epoch": {
          "type": "integer"
        },
        "epoch_status": {
          "enum": [
            "ready",
            "building",
            "unknown"
          ],
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "head_indexed": {
          "type": "boolean"
        },
        "integrity": {
          "enum": [
            "ok",
            "failed"
          ],
          "type": "string"
        },
        "integrity_problems": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "last_run": {
          "type": [
            "object",
            "null"
          ]
        },
        "path": {
          "description": "Relative to the repository: `.fathom/index.sqlite3`.",
          "type": "string"
        },
        "pending_derivation": {
          "type": "integer"
        },
        "present": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "record_schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref_tips": {
          "type": "array"
        },
        "runs": {
          "type": [
            "object",
            "null"
          ]
        },
        "scale": {
          "type": [
            "object",
            "null"
          ]
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": "integer"
        },
        "store_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "wal_bytes": {
          "type": "integer"
        },
        "commits_retained": {
          "description": "Rows in `git_commit`: everything the file retains. `commits` counts only the rows a ref still reaches, so this is the bigger number wherever a history was rewritten.",
          "type": "integer"
        },
        "dead_commits": {
          "description": "Retained commit rows no ref can reach \u2014 the commits a rebase, `--amend` or force-push replaced (ADR-004 \u00a76.2). The remedy is the pruner, `fathom index --prune` (\u00a78.1).",
          "type": "integer"
        },
        "dead_files": {
          "description": "`git_commit_file` rows the dead commits carry: what a prune reclaims with them.",
          "type": "integer"
        },
        "dead_sample": {
          "description": "Up to twelve of the dead commit ids, newest first, so a report line can name what it means. The set itself is `dead_commits`; this is its evidence.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "commit": {
                "description": "A commit row the store retains and no ref reaches.",
                "type": "string"
              }
            },
            "required": [
              "commit"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "dead_unjudged": {
          "description": "Rows that are neither reachable nor provably dead: the store hit a break in the parent chain it holds, or had no ref tip to walk from. Never reported as dead.",
          "type": "integer"
        },
        "dead_unjudged_reason": {
          "description": "Why nothing could be judged, when nothing could: the store's own words.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "present"
      ],
      "type": "object"
    },
    "repository": {
      "additionalProperties": true,
      "description": "The repository at --root, from `fathom-ingest`'s health report. When `present` is false only `error` is filled.",
      "properties": {
        "bare": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "object",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "notices": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "object_hash": {
          "type": "string"
        },
        "partial_clone": {
          "type": "boolean"
        },
        "present": {
          "type": "boolean"
        },
        "refs": {
          "type": [
            "object",
            "null"
          ]
        },
        "remotes": {
          "description": "URLs with any credential replaced by `***`.",
          "type": "array"
        },
        "root": {
          "description": "Repository-relative or `~`-relative; never an absolute home path.",
          "type": "string"
        },
        "shallow": {
          "type": "boolean"
        },
        "submodules": {
          "type": "integer"
        },
        "work_dir": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "present"
      ],
      "type": "object"
    }
  },
  "$id": "https://fathom.dev/schemas/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The sections `fathom stats`, `fathom doctor` and `fathom show` all print, defined once so three verbs cannot disagree about what 'the index' means. Owner: `e1.10`.",
  "title": "Fathom CLI - shared sections"
}
