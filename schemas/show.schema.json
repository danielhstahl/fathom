{
  "$id": "https://fathom.dev/schemas/show.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One episode in full, read out of the index: identity, authorship, message, trailers and the file rows with their taxonomy decisions. Owner: `e1.10`, on the rows `e1.2` stores.",
  "properties": {
    "asked": {
      "description": "The handle the user typed, echoed beside what it resolved to.",
      "type": "string"
    },
    "contract": {
      "const": "fathom.cli.show/1"
    },
    "degraded": {
      "type": "boolean"
    },
    "diagnostics": {
      "items": {
        "$ref": "common.schema.json#/$defs/finding"
      },
      "type": "array"
    },
    "episode": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "utc": {
              "type": "integer"
            }
          },
          "required": [
            "name",
            "email",
            "utc"
          ],
          "type": "object"
        },
        "committer_utc": {
          "type": "integer"
        },
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "add": {
                "type": "integer"
              },
              "binary": {
                "type": "boolean"
              },
              "del": {
                "type": "integer"
              },
              "hunk_headers": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "kind": {
                "type": "string"
              },
              "noise_class": {
                "type": "string"
              },
              "old_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "path": {
                "type": "string"
              },
              "path_class": {
                "type": "string"
              },
              "taxonomy_version": {
                "type": "integer"
              }
            },
            "required": [
              "path",
              "old_path",
              "kind",
              "add",
              "del",
              "binary",
              "path_class",
              "taxonomy_version",
              "noise_class",
              "hunk_headers"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "identity": {
          "additionalProperties": false,
          "description": "Which episode this commit belongs to, as the `episode` table knows it: the identity that survives a rewrite, the rule that drew its boundary and how much the tool trusts that rule. Null when the index has no episode for the commit - a store written before episode segmentation, or a commit the walk can no longer reach - because 'not known' and 'weakly known' are different statements (ADR-006 \u00a710.3).",
          "properties": {
            "add": {
              "description": "Added lines across every commit in the episode, not just this one.",
              "type": "integer"
            },
            "author_confidence": {
              "description": "`author_kind`'s confidence: a signature is certain, a heuristic is a prior.",
              "type": "number"
            },
            "author_kind": {
              "description": "`agent`, `human`, `merge`, `unknown` - the taxonomy's own kind.",
              "type": "string"
            },
            "boundary_confidence": {
              "description": "How much the boundary rule that won is trusted; `override` is 1.0 because a human said so.",
              "type": "number"
            },
            "boundary_rule": {
              "description": "Which rule opened this episode: `root`, `session`, `turn`, `signature`, `time`, `fileset`, `squash`, `override`, `initial`.",
              "type": "string"
            },
            "commits": {
              "description": "How many commits the episode holds; `members` is the same list.",
              "type": "integer"
            },
            "del": {
              "type": "integer"
            },
            "files": {
              "description": "Distinct paths the whole episode touched.",
              "type": "integer"
            },
            "fingerprint": {
              "description": "The episode's own identity digest - author plus sorted touched paths - which is what carries review state across an amend or rebase.",
              "type": "string"
            },
            "first_oid": {
              "description": "Oldest commit in the episode.",
              "type": "string"
            },
            "first_utc": {
              "type": "integer"
            },
            "id": {
              "description": "The episode id, stable across rewrites of its commits.",
              "type": "string"
            },
            "last_oid": {
              "description": "Tip commit of the episode.",
              "type": "string"
            },
            "last_utc": {
              "type": "integer"
            },
            "lineage_ref": {
              "description": "`rebase:<branch>` when the episode was relinked across a rewrite.",
              "type": [
                "string",
                "null"
              ]
            },
            "live": {
              "description": "False once the episode was rewritten away and only review state keeps it.",
              "type": "boolean"
            },
            "members": {
              "description": "Every commit id in the episode, oldest first.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "overridden": {
              "description": "True when `fathom.toml` forced this boundary; the card says so in words.",
              "type": "boolean"
            },
            "session_id": {
              "description": "Harness session when a transcript event named one.",
              "type": [
                "string",
                "null"
              ]
            },
            "turn_id": {
              "description": "Harness turn the episode answers, when known.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "fingerprint",
            "boundary_rule",
            "boundary_confidence",
            "author_kind",
            "author_confidence",
            "session_id",
            "turn_id",
            "overridden",
            "live",
            "lineage_ref",
            "first_oid",
            "last_oid",
            "commits",
            "members",
            "files",
            "add",
            "del",
            "first_utc",
            "last_utc"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "message_hash": {
          "type": "string"
        },
        "message_head": {
          "type": "string"
        },
        "noise": {
          "type": "object"
        },
        "oid": {
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scale": {
          "additionalProperties": false,
          "properties": {
            "add": {
              "type": "integer"
            },
            "binary": {
              "type": "integer"
            },
            "del": {
              "type": "integer"
            },
            "files": {
              "type": "integer"
            },
            "oversized": {
              "type": "boolean"
            }
          },
          "required": [
            "files",
            "add",
            "del",
            "binary",
            "oversized"
          ],
          "type": "object"
        },
        "short_oid": {
          "type": "string"
        },
        "trailers": {
          "type": "object"
        },
        "tree_oid": {
          "type": "string"
        }
      },
      "required": [
        "author",
        "committer_utc",
        "files",
        "identity",
        "message_hash",
        "message_head",
        "noise",
        "oid",
        "parents",
        "scale",
        "short_oid",
        "trailers",
        "tree_oid"
      ],
      "type": "object"
    },
    "repository": {
      "$ref": "common.schema.json#/$defs/repository"
    },
    "store": {
      "type": "string"
    }
  },
  "required": [
    "contract",
    "asked",
    "repository",
    "store",
    "episode",
    "degraded",
    "diagnostics"
  ],
  "title": "fathom show --json",
  "type": "object",
  "x-fathom-contract": "fathom.cli.show/1",
  "x-fathom-exit-codes": [
    {
      "code": 0,
      "name": "OK",
      "when": "the verb answered, and the index describes HEAD"
    },
    {
      "code": 1,
      "name": "ERROR",
      "when": "a rev that names nothing, an unimplemented verb, a rejected argument value"
    },
    {
      "code": 2,
      "name": "USAGE",
      "when": "clap rejected the command line (bad flag, unknown verb, missing value)"
    },
    {
      "code": 3,
      "name": "NOT_A_REPOSITORY",
      "when": "--root is not a git repository, or `.git` is unreadable"
    },
    {
      "code": 4,
      "name": "STORE_CORRUPT",
      "when": "the store failed its integrity checks"
    },
    {
      "code": 9,
      "name": "FEATURE_ABSENT",
      "when": "the verb needs a feature this binary was not built with"
    },
    {
      "code": 12,
      "name": "INDEX_DEGRADED",
      "when": "the index is missing, stale, incomplete, or a run never closed"
    }
  ],
  "x-fathom-verb": "show"
}
